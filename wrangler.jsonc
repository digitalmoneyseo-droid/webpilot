{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suchio",
  "account_id": "82dacf4c35b3f8082eb4b1090a08ea0c",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/cloudflare-worker.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "suchio.info",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/de",
      "/de/*",
      "/api/contact"
    ]
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
