{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suchio",
  "account_id": "82dacf4c35b3f8082eb4b1090a08ea0c",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/cloudflare-worker.ts",
  // Vinext writes the bundled worker after the build. This alias keeps the
  // default `wrangler deploy` command usable when Workers Builds is not given
  // the generated config explicitly.
  "alias": {
    "virtual:vinext-worker-entry": "./dist/server/index.js"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "suchio.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/de",
      "/de/*",
      "/api/contact",
      "/services/websites-apps",
      "/services/seo-ai-visibility",
      "/services/paid-campaigns",
      "/services/ai-automation",
      "/en/services/websites-apps",
      "/en/services/seo-ai-visibility",
      "/en/services/paid-campaigns",
      "/en/services/ai-automation",
      "/fr/services/websites-apps",
      "/fr/services/seo-ai-visibility",
      "/fr/services/paid-campaigns",
      "/fr/services/ai-automation"
    ]
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
